# Copy to .env (git-ignored). Everything here is a DEV-ONLY value.
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text

# Database. DB_PORT is the host port "make deps-up" publishes.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=hospital_middleware
DB_USERNAME=app
DB_PASSWORD=secret

# Auth. JWT_SECRET must be at least 16 bytes; use a real secret outside local use.
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_TTL_MINUTES=60

# Hospital information systems.
HIS_TIMEOUT_SECONDS=5
# Overrides the HIS address stored with hospital-a, e.g. to use a local mock.
HOSPITAL_A_BASE_URL=

# Host port nginx listens on (docker compose).
HTTP_PORT=80
